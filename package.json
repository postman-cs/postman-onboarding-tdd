{
  "name": "@postman-cse/onboarding-tdd",
  "version": "0.6.6",
  "description": "Postman onboarding TDD preview GitHub Action.",
  "type": "module",
  "main": "dist/action.mjs",
  "files": [
    "action.yml",
    ".postman-template/",
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "npm run typecheck && node scripts/build.mjs",
    "check:dist": "npm run build && npm run check:dist:parity",
    "check:dist:parity": "git diff --exit-code -- dist",
    "check:dist:shape": "git diff --exit-code -- dist",
    "check:dist:assert": "npm run check:dist:parity",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "lint:actions": "actionlint .github/workflows/*.yml .postman-template/workflows/*.yml .postman-template/workflows/agents/*.yml",
    "lint:fix": "eslint . --fix"
  },
  "keywords": [
    "github-action",
    "postman",
    "tdd",
    "openapi"
  ],
  "license": "MIT",
  "dependencies": {
    "@actions/artifact": "^6.2.1",
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "@postman-cse/automation-core": "^1.3.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.4",
    "esbuild": "0.28.1",
    "eslint": "^10.4.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0",
    "vitest": "^4.1.7"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/postman-cs/postman-onboarding-tdd"
  },
  "overrides": {
    "brace-expansion@1": "1.1.18",
    "brace-expansion@2": "2.1.4",
    "brace-expansion@3": "3.0.6",
    "brace-expansion@4": "5.0.9",
    "brace-expansion@5": "5.0.9",
    "fast-uri": ">=3.1.5",
    "nanoid@3": "3.3.18",
    "js-yaml@4": "4.3.1",
    "postcss": ">=8.5.26",
    "vite@8": "8.2.1",
    "ws": ">=8.21.3",
    "sharp": ">=0.35.0",
    "undici@6": "6.28.0",
    "undici@7": "7.29.0",
    "undici@8": "8.10.0"
  }
}
